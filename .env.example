# ---------------------------------------------------------------------------
# MC2026 voting system — configuration (NestJS API)
# Copy to .env and fill in. Everything event-specific (categories, voting
# window, IP ranges, geofence, display key) lives in the database and is
# managed from /admin — not here.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://vote.example.org        # used for QR codes and display links

# Master secret (>= 32 chars). Purpose-specific keys (JWT, PII encryption,
# phone HMAC, OTP HMAC) are derived from it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates sessions AND makes stored names/phones unreadable.
APP_SECRET=

# Database / cache (docker-compose fills these in for you)
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://mc:password@localhost:5432/mc2026
# REDIS_URL=redis://localhost:6379
DB_POOL_SIZE=20
# Where the built React app lives (set automatically in the Docker image)
# FRONTEND_DIST=/app/web

# Number of reverse-proxy hops in front of the app (nginx = 1). Critical for
# the on-site IP check: it decides which X-Forwarded-For entry is trusted.
TRUST_PROXY=1
COOKIE_SECURE=true

# Local event server, phones on the same Wi-Fi (docs/DEPLOYMENT.md, "Local event server").
# Run `node scripts/lan-gateway.mjs` next to Docker; it serves HTTPS to the phones and
# forwards each phone's real address, which the on-site IP check needs.
# HTTP_PORT=3000
# HTTP_BIND=127.0.0.1                # nginx reachable from this computer only: phones go through the gateway
# REAL_IP_CONF=real-ip.lan.conf      # trust the phone address forwarded by the gateway
# PUBLIC_URL=https://192.168.1.20    # the address the gateway prints; used in the QR code

# Require a signed venue QR entry before requesting/verifying SMS codes.
# The admin QR rotates every 5 seconds; printed copies expire.
REQUIRE_DYNAMIC_VOTE_QR=true

# First admin account (created on first boot only if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMS / OTP --------------------------------------------------------------
# console = log codes (dev) | twilio | http (generic JSON webhook)
SMS_PROVIDER=console
SMS_SENDER_NAME=MC2026
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# SMS_HTTP_URL=https://sms-gateway.local/send
# SMS_HTTP_TOKEN=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=30
OTP_MAX_PER_HOUR=5
# DEMO ONLY — returns the OTP in the API response; ignored when NODE_ENV=production
OTP_DEV_ECHO=false

# Phone numbers
DEFAULT_COUNTRY_CODE=962
